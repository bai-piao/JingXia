# JingXia shared environment file
# Copy this file to `.env` and adjust values for your local machine.

# jingxia-core
JINGXIA_APP_NAME=jingxia-core
JINGXIA_APP_VERSION=0.1.0
JINGXIA_API_V1_PREFIX=/api/v1
JINGXIA_DATABASE_FILENAME=jingxia.db
JINGXIA_STORAGE_DIRNAME=storage
JINGXIA_STORAGE_URL_PREFIX=/storage
# PUBLIC_BASE_URL 必须填写“最终用户真正能访问到 core 图片地址”的根地址。
# 本地直接运行 core 时，通常填 http://127.0.0.1:8000
# 如果你用局域网给别的设备访问，改成例如 http://192.168.1.20:8000
PUBLIC_BASE_URL=http://127.0.0.1:8000
JINGXIA_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:4173,http://localhost:4173
# AI_API_BASE_URL 指向宿主机或远端的 OpenAI 兼容 AI 服务
AI_API_BASE_URL=http://127.0.0.1:8081/v1
AI_MODEL_NAME=qwen-vl
AI_API_TIMEOUT=60

# jingxia-bot
TG_BOT_TOKEN=replace-with-your-telegram-bot-token
JINGXIA_API_BASE=http://127.0.0.1:8000/api/v1

# jingxia-web
# 前端开发模式推荐走 Vite 代理，保留 /api/v1 即可
VITE_CORE_API_BASE_URL=/api/v1
