# Copy to `.env` before running `docker compose up --build`

# jingxia-core
JINGXIA_APP_NAME=jingxia-core
JINGXIA_APP_VERSION=0.1.0
JINGXIA_API_V1_PREFIX=/api/v1
JINGXIA_DATABASE_FILENAME=jingxia.db
JINGXIA_STORAGE_DIRNAME=/app/storage
JINGXIA_STORAGE_URL_PREFIX=/storage
# PUBLIC_BASE_URL 必须填写“最终用户真正访问到图片的入口地址”。
# 当前 Docker 编排下，默认由 jingxia-web 暴露在 http://127.0.0.1:8080
# 如果你用局域网或域名访问，请改成例如 http://192.168.1.20:8080 或 https://jingxia.example.com
PUBLIC_BASE_URL=http://127.0.0.1:8080
JINGXIA_CORS_ORIGINS=http://127.0.0.1:8080,http://localhost:8080
# AI 服务默认跑在宿主机 8081，上层通过 host.docker.internal 访问
AI_API_BASE_URL=http://host.docker.internal:8081/v1
AI_MODEL_NAME=qwen-vl
AI_API_TIMEOUT=60

# jingxia-bot
TG_BOT_TOKEN=replace-with-your-telegram-bot-token
JINGXIA_API_BASE=http://jingxia-core:8000/api/v1

# jingxia-web
# Nginx 会代理 /api 和 /storage，前端保留相对地址即可
VITE_CORE_API_BASE_URL=/api/v1
